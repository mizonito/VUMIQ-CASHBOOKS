<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      Android 12+ (API 31+) Auto Backup & Samsung Smart Switch / Device-to-Device Transfer Rules.
      Explicitly excludes transient SQLite WAL (-wal), shared-memory (-shm), and rollback (-journal)
      files so an active Room write-ahead log is never copied in a torn state.
    -->
    <cloud-backup>
        <include domain="database" path="vumiq_cashbook_ledger.db" />
        <exclude domain="database" path="vumiq_cashbook_ledger.db-wal" />
        <exclude domain="database" path="vumiq_cashbook_ledger.db-shm" />
        <exclude domain="database" path="vumiq_cashbook_ledger.db-journal" />
        <include domain="file" path="datastore/" />
        <include domain="file" path="receipts/" />
        <include domain="file" path="recovery_snapshots/" />
    </cloud-backup>

    <device-transfer>
        <include domain="database" path="vumiq_cashbook_ledger.db" />
        <exclude domain="database" path="vumiq_cashbook_ledger.db-wal" />
        <exclude domain="database" path="vumiq_cashbook_ledger.db-shm" />
        <exclude domain="database" path="vumiq_cashbook_ledger.db-journal" />
        <include domain="file" path="datastore/" />
        <include domain="file" path="receipts/" />
        <include domain="file" path="recovery_snapshots/" />
    </device-transfer>
</data-extraction-rules>
